# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
# Only set this if your key belongs to multiple organizations — a wrong value
# causes 401 mismatched_organization errors on every request.
# OPENAI_ORG_ID=org-...

# LangSmith Configuration (Optional - for tracing)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=your_project_name
LANGCHAIN_API_KEY=your_langchain_api_key_here

# Ollama Configuration (if using local models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Vector store backend: faiss (default, in-process), chroma (embedded,
# persistent), qdrant (embedded or server), pgvector (Postgres).
# qdrant/pgvector need their extras: pip install -e ".[qdrant]" / ".[pgvector]"
VECTOR_STORE_TYPE=faiss
# Qdrant: embedded local mode by default; set QDRANT_URL to use a server
# (docker-compose.yml provides one) — same code path either way.
# QDRANT_PATH=store/qdrant
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=...            # only for authenticated Qdrant servers
# pgvector: connection string to a Postgres with the pgvector extension.
# RAGSTONE_PG_URL=postgresql+psycopg://ragstone:ragstone@localhost:5432/ragstone
# Pin a stable collection name when ONE deployment owns the store and the
# index should survive restarts (unset = unique per pipeline, the safe
# multi-pipeline default).
# RAGSTONE_COLLECTION=ragstone

# Contextual chunk enrichment (Experiment 12: hit +1.5pp, faithful +2.9pp).
# "source" prepends the document identity to every chunk (free, default);
# "llm" generates a situating sentence per chunk; "off" disables.
# RAGSTONE_CHUNK_CONTEXT=source

# Document-metadata cards (Experiment 19): one extracted title/authors/date
# chunk per document, so "who wrote this?" questions retrieve an author
# block instead of the references-section decoy. One utility-model call
# per document at ingest; "off" disables.
# RAGSTONE_METADATA_CARDS=on

# Incremental ingestion (Experiment 14: warm re-ingest 30x faster).
# Content-addressed embedding cache — re-ingesting embeds only changed
# chunks; exact-match by model+text, so results cannot change.
# RAGSTONE_EMBED_CACHE=on
# RAGSTONE_EMBED_CACHE_PATH=store/embedding_cache.sqlite

# Resilience (optional; these are the defaults)
# Retries/timeout are applied to every OpenAI LLM/embedding call; the
# timeout also bounds Ollama HTTP requests. Question length is checked
# before any API call.
# RAGSTONE_LLM_MAX_RETRIES=3
# RAGSTONE_LLM_TIMEOUT=60
# RAGSTONE_MAX_QUESTION_CHARS=4000

# Ingestion throughput: corpus embedding runs in concurrent batches
# (measured 3.1x faster than sequential on 4k chunks, identical vectors).
# RAGSTONE_EMBED_BATCH_SIZE=500
# RAGSTONE_EMBED_WORKERS=4
# RAGSTONE_BM25_WEIGHT=0.4

# Model for the utility steps (rephrase/grade/rewrite/route). Unset uses
# the main answer model. A nano model is -40% rephrase latency but fails
# challenge turns like "are you sure?" (Experiment 18) — enable only for
# non-conversational traffic.
# RAGSTONE_REPHRASE_MODEL=gpt-4.1-nano

# Conversation Memory (optional)
# Set to "sqlite" to persist chat history across restarts.
# Requires the sqlite extra: pip install -e ".[sqlite]"
# RAGSTONE_CHECKPOINT_BACKEND=memory
# RAGSTONE_CHECKPOINT_DB=store/checkpoints.sqlite

# REST API (ragstone-api) — see SECURITY.md for the deployment checklist.
# Named keys with optional per-key rate limits (name:key[:rpm],...): each
# client gets its own name in quotas, the audit log, and GET /usage, and
# can be revoked alone. The single-key form below still works (name
# "default"). No keys at all = auth disabled (development).
# RAGSTONE_API_KEYS=alice:<random-32+chars>:60,batch:<random-32+chars>
# RAGSTONE_API_KEY=<random-32+chars>   # empty = auth disabled (development)
# RAGSTONE_API_HOST=127.0.0.1
# RAGSTONE_API_PORT=8000
# RAGSTONE_API_MAX_CONCURRENCY=8
# RAGSTONE_DATA_ROOT=/srv/ragstone/data  # confine ingestion (MCP/API)

# Distributed tracing (optional): pip install -e ".[otel]" and point at an
# OTLP/HTTP collector (Jaeger, Grafana Tempo, ...). Unset = tracing off.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Application Configuration
APP_NAME=LangChain RAG Pipeline
APP_VERSION=2.1.0
DEBUG=false
