# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
# Only set this if your key belongs to multiple organizations — a wrong value
# causes 401 mismatched_organization errors on every request.
# OPENAI_ORG_ID=org-...

# LangSmith Configuration (Optional - for tracing)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=your_project_name
LANGCHAIN_API_KEY=your_langchain_api_key_here

# Ollama Configuration (if using local models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Vector Database Configuration
VECTOR_STORE_TYPE=faiss
CHROMA_PERSIST_DIR=./chroma_db
FAISS_INDEX_PATH=./faiss_index

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Application Configuration
APP_NAME=LangChain RAG Pipeline
APP_VERSION=2.0.0
DEBUG=false
